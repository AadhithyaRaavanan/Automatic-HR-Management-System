# ==============================================================================
# RemoteHR Production & Development Environment Configuration
# ==============================================================================
# All variables must follow strict validation rules defined in lib/env.ts.
# Variables prefixed with NEXT_PUBLIC_ are bundled into client JavaScript.
# NEVER put service keys, passwords, or secret tokens into NEXT_PUBLIC_ variables.

# ------------------------------------------------------------------------------
# 1. Supabase Infrastructure (Auth & PostgreSQL Database)
# ------------------------------------------------------------------------------
# Format: Full HTTPS URL (or HTTP in local dev)
# Where to find: Supabase Dashboard -> Project Settings -> API -> Project URL
# What breaks if missing: All database queries, auth sessions, and RLS will fail.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Format: Public Anon JWT token (safe for browser client)
# Where to find: Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon public)
# What breaks if missing: Client-side Supabase client cannot establish connection.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Format: Secret Service Role JWT token (SERVER RUNTIME ONLY - NEVER EXPOSE TO CLIENT)
# Where to find: Supabase Dashboard -> Project Settings -> API -> Project API Keys (service_role secret)
# What breaks if missing: Admin operations (user provisioning, invitations, system bootstrapping) fail.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Format: Direct PostgreSQL connection URI (postgresql://postgres:[password]@[host]:[port]/postgres)
# Where to find: Supabase Dashboard -> Project Settings -> Database -> Connection URI
# What breaks if missing: Direct database migrations or raw pg queries fail.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------------------------------------------------------------------
# 2. Application Host & Domain
# ------------------------------------------------------------------------------
# Primary site URL for links, invite redirects, and password resets
NEXT_PUBLIC_SITE_URL=https://pulse.zenxea.com
NEXT_PUBLIC_APP_URL=https://pulse.zenxea.com

# ------------------------------------------------------------------------------
# 2b. Candidate Onboarding Drive Link (Temporary Placeholder)
# ------------------------------------------------------------------------------
# Temporary Google Drive folder link for HR/Admin quick access. Replace anytime.
ONBOARDING_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/your_onboarding_folder_id

# ------------------------------------------------------------------------------
# 3. Email Delivery (Resend API)
# ------------------------------------------------------------------------------
# Format: Resend API Key starting with 're_'
# Where to find: Resend Dashboard (https://resend.com) -> API Keys -> Create API Key
# What breaks if missing: In production, welcome and invitation emails fail closed with typed error.
#                         In dev/test, falls back to safe console logging without leaking credentials.
RESEND_API_KEY=re_your_api_key_here

# Hostinger SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=business@zenxea.com
SMTP_PASS=your_hostinger_password
SMTP_FROM="Pulse <hr@zenxea.com>"

RESEND_FROM_EMAIL="Pulse <hr@zenxea.com>"

# ------------------------------------------------------------------------------
# 4. Bot Protection & CAPTCHA (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# Format: 0x4AAAAAA... (Cloudflare Turnstile Site Key)
# Where to find: Cloudflare Dashboard -> Turnstile -> Add Widget -> Site Key
# What breaks if missing: Captcha widget displays placeholder in dev; required in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx

# Format: 0x4AAAAAA... (Cloudflare Turnstile Secret Key - SERVER ONLY)
# Where to find: Cloudflare Dashboard -> Turnstile -> Add Widget -> Secret Key
# What breaks if missing: In production, /login and /forgot-password endpoints fail closed.
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. Distributed Rate Limiting (Upstash Redis)
# ------------------------------------------------------------------------------
# Format: Full HTTPS REST URL (e.g. https://xxxx.upstash.io)
# Where to find: Upstash Console (https://console.upstash.com) -> Redis Database -> REST API
# What breaks if missing: Falls back cleanly to high-performance local sliding-window in-memory cache.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here

# ------------------------------------------------------------------------------
# 6. Error Tracking & Observability (Sentry)
# ------------------------------------------------------------------------------
# Format: Full Sentry DSN URL (https://[key]@[host]/[project_id])
# Where to find: Sentry Dashboard -> Settings -> Projects -> [Project] -> Client Keys (DSN)
# What breaks if missing: Sentry initializes as a safe no-op.
SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

# ------------------------------------------------------------------------------
# 7. Alerting & Webhooks (Slack - Optional)
# ------------------------------------------------------------------------------
# Format: Full Slack incoming webhook URL (https://hooks.slack.com/services/...)
# Where to find: Slack App Directory -> Incoming WebHooks -> Add to Slack
# What breaks if missing: External Slack notifications are skipped.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ------------------------------------------------------------------------------
# 8. White-Label Branding & Legal Disclaimers
# ------------------------------------------------------------------------------
COMPANY_NAME="RemoteHR"
SUPPORT_EMAIL="support@yourdomain.com"
PRIVACY_POLICY_URL="/privacy"
TERMS_OF_SERVICE_URL="/terms"

# ------------------------------------------------------------------------------
# 9. Demo & Testing Flags (STRICTLY DISABLED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Must be "false" in staging and production.
NEXT_PUBLIC_DEMO_MODE=false

